# --- Docker Compose (app + postgres em containers separados) ---
POSTGRES_DB=giroam
POSTGRES_USER=giroam
POSTGRES_PASSWORD=giroam
POSTGRES_PORT=5432
APP_PORT=3000

# Host interno entre containers: serviço "db"
DATABASE_URL=postgresql://giroam:giroam@db:5432/giroam
DATABASE_SSL=false

# Sessão JWT (gere com: openssl rand -hex 32)
AUTH_SECRET=troque-este-segredo-em-producao

# URL pública do app
APP_URL=http://localhost:3000

# Cadastro: true = só com convite de capitão | false = aberto
INVITE_ONLY_REGISTRATION=true
# Validade dos convites (dias)
INVITE_EXPIRY_DAYS=14

# Conta admin inicial do seed
SEED_ADMIN_EMAIL=admin@giroam.app
SEED_ADMIN_PASSWORD=GiroAm@Admin123
SEED_ADMIN_NAME=Administrador GiroAm
SEED_ADMIN_CPF=00000000000

# --- Alternativa: Postgres EasyPanel existente (crm-app / pyroudb) ---
# DATABASE_URL=postgresql://USER:PASS@crm-app_pyroudb:5432/giroam
